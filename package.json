{
  "name": "dsh-skill-deck",
  "version": "0.1.0",
  "description": "DSH Skill Deck: browse, toggle, edit and remove agent skills from the DeepSeek Harness Settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/frontmatter.test.mjs && node test/store.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-manager"
  ],
  "license": "MIT",
  "author": "zliu0559",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zliu0559/dsh-skill-deck.git"
  },
  "homepage": "https://github.com/zliu0559/dsh-skill-deck#readme",
  "bugs": {
    "url": "https://github.com/zliu0559/dsh-skill-deck/issues"
  }
}
